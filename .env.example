# YCM ONE production environment
# Never commit real secrets. Configure these in Hostinger/server environment settings.

DATABASE_URL=
POSTGRES_URL=
YCM_SESSION_SECRET=

APP_URL=https://yojanaconnectmitra.com
RESEND_API_KEY=
YCM_FROM_EMAIL=YCM One <no-reply@yojanaconnectmitra.com>
YCM_DEV_LOGIN=false

# Provider slots: set each to a non-secret provider identifier when onboarded.
YCM_OCR=
YCM_DIGILOCKER=
YCM_JANAADHAAR=
YCM_LGD=
YCM_MAPS=
YCM_WHATSAPP=
YCM_SMS=
YCM_PAYMENTS=

YCM_PAN=
YCM_GST=
YCM_UDYAM=
YCM_BANK=
YCM_VOTER=
YCM_DL=
YCM_PASSPORT=
YCM_EDUCATION=
YCM_STATE_SERVICES=

YCM_GRIEVANCE=
YCM_RNFI=
YCM_AEPS=
YCM_AEPS_PROVIDER=SPICE_MONEY
SPICE_MONEY_API_BASE_URL=
SPICE_MONEY_API_KEY=
SPICE_MONEY_API_SECRET=
YCM_INSURANCE=
YCM_LOANS=
YCM_JOBS=
YCM_ADMISSIONS=

YCM_TRAVEL=
YCM_BUSINESS=
YCM_OTHER_SERVICES=

# Actual provider credentials belong in server-side Hostinger environment variables
# and must never be committed to this file.

# Unified payment gateway configuration (server-side secrets only)
YCM_PAYMENT_ENV=test
YCM_PAYMENT_PROVIDERS=razorpay,payu,paytm

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayU
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_WEBHOOK_SECRET=

# Paytm
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_CLIENT_ID=
PAYTM_WEBHOOK_SECRET=

# Unified financial callbacks
YCM_FINANCIAL_WEBHOOK_SECRET=
YCM_AEPS_WEBHOOK_SECRET=
YCM_SERVICE_FINANCIAL_WEBHOOK_SECRET=

# Settlement release scheduler (server-side only)
YCM_SETTLEMENT_RELEASE_SECRET=
YCM_SETTLEMENT_POLICY=T_PLUS_1
# Eko UAT/production credentials (server-side only)
EKO_ENV=uat
EKO_BASE_URL=https://staging.eko.in:25004
EKO_DEVELOPER_KEY=
EKO_ACCESS_KEY=
EKO_INITIATOR_ID=
# Eko callback ingress protection (configure at the reverse proxy/provider integration boundary)
EKO_CALLBACK_SHARED_SECRET=
