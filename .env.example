# YCM ONE production environment
# Never commit real secrets. Configure these in Hostinger/server environment settings.

# PostgreSQL / Hostinger database
DATABASE_URL=
# Alternative supported variable name:
# POSTGRES_URL=

# Server-only HMAC secret for isolated YCM sessions. Use a long random value (32+ bytes).
YCM_SESSION_SECRET=

# Legal Mitra
LEGAL_PAYMENT_CHECKOUT_URL=
LEGAL_PAYMENT_WEBHOOK_SECRET=
LEGAL_AI_PROVIDER_KEY=
LEGAL_SPEECH_TO_TEXT_KEY=

# Local-only role workspace preview. NEVER enable in production.
YCM_DEV_LOGIN=false
YCM_SESSION_SECRET=replace-with-a-long-random-secret

# Authentication / production password recovery
APP_URL=https://yojanaconnectmitra.com
RESEND_API_KEY=
YCM_FROM_EMAIL=YCM One <no-reply@yojanaconnectmitra.com>
